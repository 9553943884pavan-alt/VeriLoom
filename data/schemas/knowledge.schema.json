{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge",
  "type": "object",
  "required": [
    "record_id",
    "organisation_id",
    "document_id",
    "local_id",
    "title",
    "text",
    "category",
    "source_path",
    "source_version",
    "status",
    "effective_from",
    "effective_to",
    "data_kind",
    "ingestible"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "organisation_id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "local_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "approved",
        "archived"
      ]
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "effective_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "data_kind": {
      "enum": [
        "synthetic_demo"
      ]
    },
    "ingestible": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
