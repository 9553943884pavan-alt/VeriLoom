{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scope_case",
  "type": "object",
  "required": [
    "case_id",
    "data_kind",
    "authenticated_organisation_id",
    "as_of",
    "query",
    "candidate_source_ids",
    "expected_allowed_ids",
    "expected_excluded_ids",
    "purpose"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "data_kind": {
      "enum": [
        "synthetic_demo"
      ]
    },
    "authenticated_organisation_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "candidate_source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "expected_allowed_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "expected_excluded_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
