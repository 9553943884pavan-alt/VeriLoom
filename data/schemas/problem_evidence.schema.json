{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "problem_evidence",
  "type": "object",
  "required": ["record_id", "data_kind", "ingestible", "publisher", "publication_title", "published_year", "survey_field_dates", "sample", "metric", "population", "summary", "source_url", "accessed_at", "caveat"],
  "properties": {
    "record_id": {"type": "string", "pattern": "^EVID-[0-9]{2}$"},
    "data_kind": {"const": "public_problem_evidence"},
    "ingestible": {"const": false},
    "publisher": {"type": "string", "minLength": 1},
    "publication_title": {"type": "string", "minLength": 1},
    "published_year": {"type": "integer", "minimum": 2000},
    "survey_field_dates": {"type": ["string", "null"]},
    "sample": {"type": "string", "minLength": 1},
    "metric": {"type": ["string", "null"]},
    "population": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "accessed_at": {"type": "string", "format": "date"},
    "caveat": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
