# VeriLoom configuration template. Copy to .env for local development.
# Replace placeholders locally or in Render/Vercel settings. Never put real secrets in this file.
# Shared by the Render API and worker
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Render API only; set APP_ORIGIN to the exact deployed Vercel origin in production
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
APP_ORIGIN=http://localhost:5173

# Shared by the Render API and worker: private R2 originals
R2_ACCOUNT_ID=REPLACE_WITH_R2_ACCOUNT_ID
R2_BUCKET=REPLACE_WITH_PRIVATE_BUCKET_NAME
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY

# Render worker only: Sarvam AI chat; confirm structured JSON support
SARVAM_API_KEY=REPLACE_WITH_SARVAM_API_KEY
SARVAM_MODEL=sarvam-105b

# Local retrieval models run in the worker; no external embedding API key is needed
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Frontend: public, non-secret value. Browser requests go through same-origin rewrite/proxy.
VITE_API_BASE=/api/v1
